# ---- Backend (PHP) — copy to backend/.env ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=avm_website
DB_USER=root
DB_PASS=
CORS_ORIGIN=http://localhost:5173
SESSION_NAME=AVMSESSID

# ---- Frontend (Vite) — copy to frontend/.env ----
VITE_API_BASE_URL=http://localhost:8000

# Show real DB error messages in API responses (auto-on for localhost)
APP_DEBUG=true
